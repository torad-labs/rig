# rig: the program, the engine pin and the heads are in git; everything generated is not.
# Weights are never committed — except a head's small load-bearing asset, the calibrated K-cache
# bias under heads/<head>/assets/. A [derive] adapter is a private asset: pinned by sha256 in
# head.toml, stored in the models remote (torad model, below), never in git.
*.gguf
!heads/*/assets/kv-mean-center-*.gguf
# everything rig generates: packs, binaries, build trees, logs, gate evidence, rented-box state
local/*
!local/README.md
# the compiled binary (bun run build) and the dependencies
dist/
node_modules/
*.log
*.bak
*.bak-*
# impeccable's per-machine overrides
.impeccable/config.local.json

# >>> torad-models-managed (auto-generated; do not edit inside) >>>
.torad.models.state.json
.env
.env.local
*.part
*.torad-blob-*.part
/local/packs/bonsai-2-27b
/heads/bonsai-2-27b/assets/lora
# <<< torad-models-managed <<<
